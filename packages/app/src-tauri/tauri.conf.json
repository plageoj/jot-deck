{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jot Deck",
  "version": "0.1.0",
  "identifier": "com.jot-deck.app",
  "build": {
    "beforeDevCommand": "pnpm build:mcp-sidecar && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm build:mcp-sidecar",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Jot Deck",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/jot-deck-mcp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/plageoj/jot-deck/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4RkMwOEE1Q0E5MTc0NDQKUldSRWRKSEtwUWo4YUZBZUxueHVTOHJQRE5WcjdjTzNjNTFrT3pZV2VmWWxoNHlSaTQyNTdsZW4K"
    }
  }
}
