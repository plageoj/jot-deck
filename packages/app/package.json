{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "description": "Jot Deck - Fast drafting tool with TweetDeck-style UI",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:demo": "playwright test e2e/demo.spec.ts --headed",
    "test:e2e:ui": "playwright test --ui",
    "build:mcp-sidecar": "node ../../scripts/build-mcp-sidecar.mjs",
    "tauri": "tauri"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@replit/codemirror-vim": "^6.4.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "codemirror": "^6.0.2",
    "marked": "^18.0.13",
    "sql.js": "^1.14.2",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/svelte": "^5.4.2",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
