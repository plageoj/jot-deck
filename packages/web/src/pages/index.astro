---
const RELEASE_PAGE = "https://github.com/plageoj/jot-deck/releases/tag/preview";
const REPO = "https://github.com/plageoj/jot-deck";

const features = [
  {
    icon: "zap",
    title: "0.5s startup",
    description: "Your thoughts shouldn't wait",
  },
  {
    icon: "keyboard",
    title: "Vim + Twitter keybindings",
    description: "hjkl navigation, never touch your mouse",
  },
  {
    icon: "layers",
    title: "Cards, not documents",
    description: "Think in fragments, not paragraphs",
  },
  {
    icon: "plug",
    title: "Open to your agent",
    description: "Your AI agent reads and writes your deck over MCP",
  },
  {
    icon: "radio",
    title: "Reporters",
    description: "Stream transcripts, webhooks and agent logs into columns",
  },
  {
    icon: "lock",
    title: "Local-first, always",
    description: "SQLite on your disk. No account, no cloud, no telemetry.",
  },
];

// Defaults from packages/app/src/lib/keybindings.ts — keep in sync if they move.
const keys = [
  { key: "o", label: "New card" },
  { key: "h j k l", label: "Move anywhere" },
  { key: "i", label: "Edit" },
  { key: "d d", label: "Delete" },
  { key: "u", label: "Undo" },
  { key: "y y / p", label: "Copy, paste" },
  { key: "c", label: "New column" },
  { key: "/", label: "Filter by tag" },
  { key: "g t", label: "Trash" },
  { key: "Ctrl P", label: "Switch deck" },
];

// Format rows for the download matrix. `key` is matched against the release
// assets by the client script; the href stays on the release page until then,
// so every link works even with JS off or the GitHub API unreachable.
const downloads = [
  {
    os: "windows",
    label: "Windows",
    note: "Windows 10 and 11, 64-bit",
    formats: [
      { key: "windows-exe", label: ".exe installer" },
      { key: "windows-msi", label: ".msi" },
    ],
  },
  {
    os: "macos",
    label: "macOS",
    note: "Universal — Apple Silicon and Intel",
    formats: [{ key: "macos-dmg", label: ".dmg" }],
  },
  {
    os: "linux",
    label: "Linux",
    note: "x86_64",
    formats: [
      { key: "linux-appimage", label: ".AppImage" },
      { key: "linux-deb", label: ".deb" },
      { key: "linux-rpm", label: ".rpm" },
    ],
  },
];

const mcpSnippet = `{
  "mcpServers": {
    "jot-deck": {
      "command": "/path/to/jot-deck-mcp",
      "env": {
        "JOT_DECK_DECK_ID": "01J...your-deck-id"
      }
    }
  }
}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Jot Deck — Jot Down. Shape Up.</title>
    <meta
      name="description"
      content="A keyboard-driven, local-first note app. Capture ideas as tweet-sized cards in TweetDeck-style columns — and open your deck to your own AI agent over MCP. Free preview for Windows, macOS and Linux."
    />
    <meta property="og:title" content="Jot Deck — Jot Down. Shape Up." />
    <meta
      property="og:description"
      content="A keyboard-driven, local-first note app. Capture ideas as tweet-sized cards — and open your deck to your own AI agent over MCP."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://jot-deck.com" />
    <meta property="og:image" content="https://jot-deck.com/ogp.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://jot-deck.com/ogp.png" />
  </head>
  <body>
    <main>
      <section class="hero">
        <div class="container">
          <p class="tagline">Jot Down. Shape Up.</p>
          <h1>Jot Deck</h1>
          <p class="hook">
            <strong>Tired of waiting for Notion to load?</strong><br />
            <strong>Or getting lost in deep nested bullet lists?</strong>
          </p>
          <p class="description">
            Flat, tweet-sized cards in TweetDeck-style columns. No hierarchy, no
            lag, no mouse. Then hand the whole deck to your own AI agent.
          </p>

          <div class="cta">
            <a
              id="dl-primary"
              class="button primary"
              href={RELEASE_PAGE}
              rel="noopener">Download Preview</a
            >
            <a class="button secondary" href="#download">All downloads →</a>
          </div>
          <p class="cta-meta">
            <span id="dl-version" hidden></span>
            <span
              >Preview build · Windows, macOS &amp; Linux · free, no account</span
            >
          </p>
        </div>
      </section>

      <section class="screenshot">
        <div class="container">
          <img
            src="/app-screenshot.png"
            alt="Jot Deck showing a Writing deck with Inbox, Research and Drafts columns of short cards"
            width="1200"
            height="660"
          />
        </div>
      </section>

      <section class="keys">
        <div class="container">
          <h2>Everything is a keystroke</h2>
          <ul class="key-list">
            {
              keys.map((k) => (
                <li>
                  <kbd>{k.key}</kbd>
                  <span>{k.label}</span>
                </li>
              ))
            }
          </ul>
          <p class="keys-note">
            Press <kbd>?</kbd> in the app for the full sheet. Rebind anything in
            Settings.
          </p>
        </div>
      </section>

      <section id="features" class="features">
        <div class="container">
          <h2>Why Jot Deck?</h2>
          <div class="feature-grid">
            {
              features.map((feature) => (
                <div class="feature-card">
                  <div class="feature-icon" data-icon={feature.icon} />
                  <h3>{feature.title}</h3>
                  <p>{feature.description}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section id="mcp" class="mcp">
        <div class="container">
          <h2>Your deck, open to your agent</h2>
          <p class="section-lead">
            Jot Deck runs no AI of its own. It speaks <strong>MCP</strong>, so
            the agent you already use can work directly on your deck. Any
            MCP-capable client, no API keys, no second bill.
          </p>

          <div class="split">
            <div class="split-item">
              <h3>It reads</h3>
              <p>
                "What did I conclude about pricing?" Search, recall and draft
                from months of notes.
              </p>
            </div>
            <div class="split-item">
              <h3>It writes</h3>
              <p>
                "File the key points from this PDF into Research." Agents can
                log their own work as they go.
              </p>
            </div>
          </div>

          <p class="section-body">
            Columns and cards <strong>are</strong> the chunking an agent needs —
            done when you typed it, not after the fact.
          </p>

          <div class="snippet">
            <p class="snippet-label">The whole setup:</p>
            <pre><code>{mcpSnippet}</code></pre>
            <p class="snippet-note">
              The app fills in the real path and deck id for you — <em
                >Copy MCP server config</em
              > in the Deck switcher.
            </p>
          </div>

          <p class="note">
            Columns you mark <strong>private</strong> stay invisible over MCP.
          </p>
        </div>
      </section>

      <section id="reporters" class="reporters">
        <div class="container">
          <h2>Reporters <span class="badge">in development</span></h2>
          <p class="section-lead">
            Reporters pipe live input into your columns — meeting transcripts,
            webhooks, an agent's task log — cut into short cards as it happens,
            never one endlessly growing wall of text.
          </p>
          <p class="note">
            Not shipped yet. Jot Deck itself stays free.
          </p>
        </div>
      </section>

      <section class="tech">
        <div class="container">
          <p class="tech-stack">
            Built with <strong>Tauri + Rust</strong> for native performance.<br
            />
            Offline-first with <strong>SQLite</strong>.<br />
            Speaks <strong>MCP</strong> over stdio, as a bundled sidecar.
          </p>
        </div>
      </section>

      <section id="download" class="download">
        <div class="container">
          <h2>Download the Preview</h2>
          <p class="section-lead">
            Every push to <code>main</code> ships a fresh build for all three
            platforms. No stable release yet — this is the way in.
          </p>

          <div class="dl-grid">
            {
              downloads.map((d) => (
                <div class="dl-os" data-os={d.os}>
                  <h3>{d.label}</h3>
                  <p class="dl-note">{d.note}</p>
                  <ul>
                    {d.formats.map((f) => (
                      <li>
                        <a data-asset={f.key} href={RELEASE_PAGE} rel="noopener">
                          {f.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>

          <ul class="caveats">
            <li>
              <strong>Not code-signed yet.</strong> Windows: <em>More info → Run
              anyway</em>. macOS: right-click → <em>Open</em>.
            </li>
            <li>
              <strong>Installs as its own app,</strong> with its own data — a
              rough preview can't touch a future stable install.
            </li>
            <li><strong>Updates itself,</strong> and asks first.</li>
          </ul>
        </div>
      </section>

      <footer>
        <div class="container">
          <p class="footer-links">
            <a href={REPO} rel="noopener">GitHub</a>
            <a href={`${REPO}/releases`} rel="noopener">Releases</a>
          </p>
          <p>&copy; 2026 Jot Deck. All rights reserved.</p>
        </div>
      </footer>
    </main>

    <script>
      // Progressive enhancement for the download links, in three tiers:
      //   1. The server-rendered href already points at the preview release
      //      page and always works — with JS off, offline, whatever.
      //   2. Detect the OS (no network) and relabel/reorder.
      //   3. Ask the GitHub API for the exact current asset URLs.
      // Tier 3 failing is fine and silent: tiers 1-2 already left a working
      // button. The `preview` tag is rolling and asset filenames carry the
      // version, so the URLs can't be baked in at build time.
      const API =
        "https://api.github.com/repos/plageoj/jot-deck/releases/tags/preview";
      const DL_PREFIX = "https://github.com/plageoj/jot-deck/releases/download/";
      const CACHE_KEY = "jot-deck:preview-release:v1";

      const PATTERNS: Record<string, RegExp> = {
        "windows-exe": /_x64-setup\.exe$/,
        "windows-msi": /_x64_en-US\.msi$/,
        "macos-dmg": /_universal\.dmg$/,
        "linux-appimage": /_amd64\.AppImage$/,
        "linux-deb": /_amd64\.deb$/,
        "linux-rpm": /\.x86_64\.rpm$/,
      };
      const PRIMARY: Record<string, string> = {
        windows: "windows-exe",
        macos: "macos-dmg",
        linux: "linux-appimage",
      };
      const OS_LABEL: Record<string, string> = {
        windows: "Windows",
        macos: "macOS",
        linux: "Linux",
      };

      const primaryEl = document.getElementById(
        "dl-primary",
      ) as HTMLAnchorElement | null;
      const versionEl = document.getElementById("dl-version");

      function detectOS(): string | null {
        const nav = navigator as Navigator & {
          userAgentData?: { platform?: string };
        };
        const hint = nav.userAgentData?.platform ?? nav.platform ?? "";
        const probe = (hint + " " + (nav.userAgent ?? "")).toLowerCase();
        // Mobile first — those UAs also contain "mac" / "linux".
        if (/android|iphone|ipad|ipod/.test(probe)) return null;
        if (/win/.test(probe)) return "windows";
        if (/mac|darwin/.test(probe)) return "macos";
        if (/linux|x11|cros/.test(probe)) return "linux";
        return null;
      }

      const os = detectOS();

      // Tier 2: label the button and float the visitor's platform to the front
      // of the download grid.
      if (os) {
        if (primaryEl) primaryEl.textContent = "Download for " + OS_LABEL[os];
        const grid = document.querySelector(".dl-grid");
        const mine = grid?.querySelector('.dl-os[data-os="' + os + '"]');
        if (grid && mine) grid.prepend(mine);
      }

      type Trimmed = { name: string; assets: Record<string, string> };

      function apply(data: Trimmed) {
        for (const el of document.querySelectorAll<HTMLAnchorElement>(
          "[data-asset]",
        )) {
          const url = data.assets[el.dataset.asset ?? ""];
          if (url) el.href = url;
        }
        if (os && primaryEl) {
          const url = data.assets[PRIMARY[os]];
          if (url) primaryEl.href = url;
        }
        const version = /\(([^)]+)\)/.exec(data.name)?.[1];
        if (version && versionEl) {
          versionEl.textContent = "Version " + version;
          versionEl.hidden = false;
        }
      }

      function trim(release: any): Trimmed {
        const assets: Record<string, string> = {};
        for (const asset of release?.assets ?? []) {
          const name: string = asset?.name ?? "";
          const url: unknown = asset?.browser_download_url;
          // A .sig sidecar sits next to every bundle; never link one.
          if (name.endsWith(".sig")) continue;
          if (typeof url !== "string" || !url.startsWith(DL_PREFIX)) continue;
          for (const key of Object.keys(PATTERNS)) {
            if (!assets[key] && PATTERNS[key].test(name)) assets[key] = url;
          }
        }
        return { name: String(release?.name ?? ""), assets };
      }

      // Tier 3. The unauthenticated GitHub API allows 60 req/hr/IP, so reuse
      // the answer for the rest of the session.
      const cached = sessionStorage.getItem(CACHE_KEY);
      if (cached) {
        try {
          apply(JSON.parse(cached) as Trimmed);
        } catch {
          sessionStorage.removeItem(CACHE_KEY);
        }
      } else {
        fetch(API, { headers: { Accept: "application/vnd.github+json" } })
          .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
          .then((release) => {
            const data = trim(release);
            if (!Object.keys(data.assets).length) return;
            sessionStorage.setItem(CACHE_KEY, JSON.stringify(data));
            apply(data);
          })
          .catch(() => {
            /* keep the release-page fallback */
          });
      }
    </script>

    <style>
      :root {
        --color-bg: #0a0a0a;
        --color-surface: #141414;
        --color-border: #262626;
        --color-text: #fafafa;
        --color-text-muted: #a1a1aa;
        --color-primary: #3b82f6;
        --color-primary-hover: #2563eb;
        --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
          Roboto, sans-serif;
        --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
      }

      @media (prefers-color-scheme: light) {
        :root {
          --color-bg: #fafafa;
          --color-surface: #ffffff;
          --color-border: #e4e4e7;
          --color-text: #09090b;
          --color-text-muted: #71717a;
        }
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-sans);
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.6;
      }

      .container {
        max-width: 1024px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* Hero */
      .hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 4rem 0;
      }

      .tagline {
        font-family: var(--font-mono);
        font-size: 0.875rem;
        color: var(--color-primary);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 1rem;
      }

      .hero h1 {
        font-size: clamp(3rem, 10vw, 6rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 2rem;
      }

      .hook {
        font-size: 1.25rem;
        color: var(--color-text-muted);
        margin-bottom: 1.5rem;
      }

      .hook strong {
        color: var(--color-text);
      }

      .description {
        font-size: 1.125rem;
        color: var(--color-text-muted);
        max-width: 600px;
        margin: 0 auto 2.5rem;
      }

      /* CTA */
      .cta {
        display: flex;
        gap: 0.75rem;
        justify-content: center;
        flex-wrap: wrap;
      }

      .cta-meta {
        margin-top: 1rem;
        font-size: 0.875rem;
        color: var(--color-text-muted);
        display: flex;
        gap: 0.5rem;
        justify-content: center;
        flex-wrap: wrap;
      }

      #dl-version {
        font-family: var(--font-mono);
        color: var(--color-text);
      }

      #dl-version::after {
        content: "·";
        margin-left: 0.5rem;
        color: var(--color-text-muted);
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.875rem 1.75rem;
        font-size: 1rem;
        font-weight: 500;
        text-decoration: none;
        border-radius: 8px;
        transition: all 0.15s ease;
      }

      .button.primary {
        background: var(--color-primary);
        color: white;
      }

      .button.primary:hover {
        background: var(--color-primary-hover);
      }

      button.button {
        border: none;
        cursor: pointer;
      }

      .button.secondary {
        background: var(--color-surface);
        color: var(--color-text);
        border: 1px solid var(--color-border);
      }

      .button.secondary:hover {
        border-color: var(--color-text-muted);
      }

      /* Screenshot */
      .screenshot {
        padding: 0 0 4rem;
      }

      .screenshot img {
        width: 100%;
        height: auto;
        border-radius: 12px;
        border: 1px solid var(--color-border);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4);
      }

      /* Keys */
      .keys {
        padding: 5rem 0;
        text-align: center;
      }

      .keys h2 {
        font-size: 2rem;
        margin-bottom: 2.5rem;
      }

      .key-list {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
      }

      .key-list li {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.5rem 0.9rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 999px;
        font-size: 0.875rem;
        color: var(--color-text-muted);
      }

      kbd {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--color-text);
        white-space: nowrap;
      }

      .keys-note {
        margin-top: 2rem;
        font-size: 0.875rem;
        color: var(--color-text-muted);
      }

      /* Features */
      .features {
        padding: 6rem 0;
        background: var(--color-surface);
      }

      .features h2 {
        font-size: 2rem;
        text-align: center;
        margin-bottom: 3rem;
      }

      /* 260px keeps six tiles at 3+3 on desktop rather than a lopsided 4+2. */
      .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 2rem;
      }

      .feature-card {
        padding: 1.5rem;
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: 12px;
      }

      .feature-icon {
        width: 48px;
        height: 48px;
        background: var(--color-primary);
        border-radius: 10px;
        margin-bottom: 1rem;
        opacity: 0.9;
      }

      .feature-card h3 {
        font-size: 1.125rem;
        margin-bottom: 0.5rem;
      }

      .feature-card p {
        font-size: 0.9375rem;
        color: var(--color-text-muted);
      }

      /* Shared section typography */
      .section-lead {
        font-size: 1.125rem;
        color: var(--color-text-muted);
        max-width: 46rem;
      }

      .section-body {
        color: var(--color-text-muted);
        max-width: 46rem;
        margin-top: 1.5rem;
      }

      .section-lead strong,
      .section-body strong {
        color: var(--color-text);
      }

      .note {
        margin-top: 2rem;
        padding: 1rem 1.25rem;
        border-left: 3px solid var(--color-primary);
        background: var(--color-surface);
        border-radius: 0 8px 8px 0;
        font-size: 0.9375rem;
        color: var(--color-text-muted);
        max-width: 46rem;
      }

      .note strong {
        color: var(--color-text);
      }

      /* MCP */
      .mcp {
        padding: 6rem 0;
      }

      .mcp h2,
      .reporters h2,
      .download h2 {
        font-size: 2rem;
        margin-bottom: 1rem;
      }

      .split {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 2rem;
        margin-top: 2.5rem;
      }

      .split-item h3 {
        font-size: 1.0625rem;
        margin-bottom: 0.5rem;
      }

      .split-item p {
        color: var(--color-text-muted);
        font-size: 0.9375rem;
      }

      .snippet {
        margin-top: 2.5rem;
      }

      .snippet-label {
        font-size: 0.9375rem;
        color: var(--color-text-muted);
        margin-bottom: 0.75rem;
      }

      .snippet pre {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        padding: 1.25rem;
        overflow-x: auto;
      }

      .snippet code {
        font-family: var(--font-mono);
        font-size: 0.875rem;
        line-height: 1.7;
        color: var(--color-text);
      }

      .snippet-note {
        margin-top: 0.75rem;
        font-size: 0.875rem;
        color: var(--color-text-muted);
      }

      /* Reporters */
      .reporters {
        padding: 6rem 0;
        background: var(--color-surface);
      }

      .reporters .note {
        background: var(--color-bg);
      }

      .badge {
        display: inline-block;
        vertical-align: middle;
        margin-left: 0.5rem;
        padding: 0.2rem 0.6rem;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--color-primary);
        border: 1px solid var(--color-primary);
        border-radius: 999px;
      }

      /* Tech */
      .tech {
        padding: 4rem 0;
        text-align: center;
      }

      .tech-stack {
        font-family: var(--font-mono);
        font-size: 0.9375rem;
        color: var(--color-text-muted);
        line-height: 2;
      }

      .tech-stack strong {
        color: var(--color-text);
      }

      /* Download */
